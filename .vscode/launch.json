{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File (venv + sudo)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "python": "${workspaceFolder}/venv/bin/python",
            "console": "externalTerminal",
            "justMyCode": true,
            "sudo": true
        },
        {
            "name": "Python: networkscan.py (venv + sudo)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/framework/auxiliaries/networkscan.py",
            "python": "${workspaceFolder}/venv/bin/python",
            "console": "externalTerminal",
            "justMyCode": true,
            "sudo": true
        },
        {
            "name": "Debug C++ Program",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/helloworld",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
