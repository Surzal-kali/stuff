# --- bytecode / build artifacts ---
__pycache__/
*.pyc
*.pyo
*.so
*.exe

# --- runtime state / local data (deliberately untracked) ---
ids.db
*.sqlite3
*.memory/
chroma-data/
.zap_home/
findings_md/
scope/
*.scope
/binaries/*
!/binaries/.gitkeep
!/binaries/README.md
bugcheck_ledger.md
ledger_archive/*
briefs/*
docs/*

# --- secrets / env ---
.env
framework.env
*.pem
dockered/.webui_secret_key

# --- local scratch ---
WIP_*.*

# --- editor droppings ---
*.swp
.*.swp

# --- dependency lockfiles ---
# requirements.md is the tracked canonical freeze; requirements.txt is a
# synced byte-identical mirror. The exception un-ignores it so the mirror is
# version-controlled and future drift shows up in git diffs.
*.txt
!requirements.txt