# --- bytecode / build artifacts ---
__pycache__/
*.pyc
*.pyo
*.so
*.exe

# --- runtime state / local data (deliberately untracked) ---
ids.db
*.sqlite3
*.memory/
chroma-data/
.zap_home/
.pw-browsers/
findings_md/
scope/
*.scope
/binaries/*
!/binaries/.gitkeep
!/binaries/README.md
/apk/*
!/apk/.gitkeep
!/apk/README.md
# --- payload dropbox (generated munitions; msfvenom output root) ---
/dropbox/*
!/dropbox/.gitkeep
!/dropbox/README.md
# --- packet captures (scapy wrpcap output; forensic evidence) ---
/pcaps/*
!/pcaps/.gitkeep
!/pcaps/README.md
bugcheck_ledger.md
ledger_archive/*
briefs/*
docs/*

# --- secrets / env ---
.env
framework.env
*.pem
dockered/.webui_secret_key

# --- local scratch ---
WIP_*.*

# --- editor droppings ---
*.swp
.*.swp

# --- dependency lockfiles ---
# requirements.txt is the tracked canonical pinned dependency freeze.
# The exception un-ignores it so it stays version-controlled.
*.txt
!requirements.txt
todo.md
dockered/.env.save
.vscode/*
hydra.restore
scratch.*
cookie_jar.db*
scratch-data/*